#!/usr/bin/env bash
# tintim-doc-save: write a tintim-docs entry from stdin, update INDEX and WORKLOG.
# usage: tintim-doc-save <slug> <one-line-summary>   (markdown via stdin)
set -euo pipefail

if [ $# -lt 2 ]; then
  echo "usage: tintim-doc-save <slug> <one-line-summary>" >&2
  echo "       (markdown content via stdin)" >&2
  exit 1
fi

SLUG="$1"
SUMMARY="$2"
DOCS="${TINTIM_DOCS_DIR:-$HOME/workspace/work/tintim-docs}"
DATE=$(date +%Y-%m-%d)
FILE="$DOCS/${DATE}-${SLUG}.md"
INDEX="$DOCS/INDEX.md"
WORKLOG="$DOCS/WORKLOG.md"

mkdir -p "$DOCS"

if [ -e "$FILE" ]; then
  echo "ERROR: $FILE already exists" >&2
  exit 1
fi

cat > "$FILE"
echo "wrote: $FILE"

if [ ! -f "$INDEX" ]; then
  cat > "$INDEX" <<'EOF'
# tintim-docs index

Mais recente no topo. Formato: `YYYY-MM-DD — <slug> — <summary>`.

---

EOF
fi

if [ ! -f "$WORKLOG" ]; then
  cat > "$WORKLOG" <<'EOF'
# Tintim worklog

Append-only. One line per entry. Format: `YYYY-MM-DD — <decisão / mudança / discussão>`.
Mais recente no topo.

---

EOF
fi

prepend_after_separator() {
  local file="$1"
  local line="$2"
  if ! grep -q "^---$" "$file"; then
    echo "ERROR: no '---' separator in $file" >&2
    exit 1
  fi
  awk -v line="$line" '
    /^---$/ && !done { print; print ""; print line; done=1; next }
    { print }
  ' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
}

prepend_after_separator "$INDEX"   "${DATE} — ${SLUG} — ${SUMMARY}"
prepend_after_separator "$WORKLOG" "${DATE} — ${SUMMARY} (doc: ${DATE}-${SLUG})"

echo "indexed: $INDEX"
echo "logged:  $WORKLOG"
